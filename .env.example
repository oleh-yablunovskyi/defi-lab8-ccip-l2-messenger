# Settings of the scripts. Copy this file to .env and fill it in; git ignores .env.
# ENV_FILE=<file> selects another file, for example the one of the trial run on a fork.

# JSON-RPC endpoints of Sepolia (L1) and Arbitrum Sepolia (L2); public ones are used when empty
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Private key of the wallet that deploys the contracts on both chains and that the agent signs
# with. Never commit or share it.
DEPLOYER_PRIVATE_KEY=

# scripts/agent.ts and scripts/check-receiver.ts read the contract addresses from deployments/
# (written by scripts/deploy.ts); non-empty values here replace them
MESSENGER_ADDRESS=
RECEIVER_ADDRESS=
